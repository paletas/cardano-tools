{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "alpinejs@3.2.1",
      "destination": "wwwroot/lib/alpinejs/"
    },
    {
      "library": "moment.js@2.31.0",
      "destination": "wwwroot/lib/moment.js/"
    },
    {
      "library": "microsoft-signalr@5.0.7",
      "destination": "wwwroot/lib/microsoft-signalr/"
    },
    {
      "library": "require.js@2.3.8",
      "destination": "wwwroot/lib/require.js/"
    },
    {
      "library": "apexcharts@8.9.1",
      "destination": "wwwroot/lib/apexcharts/",
      "files": [ "apexcharts.js", "apexcharts.min.js", "apexcharts.css", "apexcharts.min.css", "locales/*.json" ]
    },
    {
      "library": "lodash.js@4.17.21",
      "destination": "wwwroot/lib/lodash/"
    },
    {
      "library": "numeral.js@2.0.6",
      "destination": "wwwroot/lib/numeral/"
    }
  ]
}